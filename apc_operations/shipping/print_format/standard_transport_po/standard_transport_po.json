 "html": "{% set company = frappe.db.get_default(\"company\") or frappe.db.get_single_value(\"Global Defaults\", \"default_company\") %}\\n{% set company_logo = frappe.db.get_value(\"Company\", company, \"company_logo\") if company else \"\" %}\\n{% set company_name = frappe.db.get_value(\"Company\", company, \"company_name\") if company else \"ASIA PETROCHEMICALS LLC OPC\" %}\\n<style>\\n  .po-page { border: 1px solid #2f2f2f; padding: 14px; font-family: Arial, sans-serif; color: #222; margin: 8px; }\\n  .po-title { text-align: center; font-size: 22px; font-weight: 700; margin: 4px 0 10px; }\\n  .po-grid { width: 100%; border-collapse: collapse; }\\n  .po-grid td { border: 1px solid #2f2f2f; vertical-align: top; }\\n  .pad { padding: 6px 8px; font-size: 12px; }\\n  .head-box { width: 100%; border-collapse: collapse; }\\n  .head-box td { border: none; }\\n  .logo { width: 95px; }\\n  .logo img { width: 86px; height: 58px; object-fit: contain; }\\n  .company { font-size: 15px; font-weight: 700; }\\n  .small { font-size: 11px; color: #444; }\\n  .kv { width: 100%; border-collapse: collapse; }\\n  .kv td { border: none; padding: 2px 0; font-size: 12px; }\\n  .kv .k { width: 45%; font-weight: 700; }\\n  .kv .c { width: 4%; text-align: center; }\\n  .money { font-size: 18px; font-weight: 700; }\\n  .signature-row { margin-top: 20px; width: 100%; border-collapse: collapse; }\\n  .signature-row td { width: 33.33%; text-align: center; font-size: 11px; padding-top: 28px; }\\n  .sig-line { border-top: 1px solid #2f2f2f; margin: 0 10px 6px; }\\n</style>\\n\\n<div class=\"po-page\">\\n  <div class=\"po-title\">TRANSPORT PURCHASE ORDER</div>\\n\\n  <table class=\"po-grid\">\\n    <tr>\\n      <td style=\"width:50%;\" class=\"pad\">\\n        <table class=\"head-box\">\\n          <tr>\\n            <td class=\"logo\">\\n              {% if company_logo %}\\n              <img src=\"{{ company_logo }}\" alt=\"Company Logo\">\\n              {% endif %}\\n            </td>\\n            <td>\\n              <div class=\"company\">{{ company_name }}</div>\\n              <div class=\"small\">Internal Transport Payables Document</div>\\n            </td>\\n          </tr>\\n        </table>\\n      </td>\\n      <td style=\"width:50%;\" class=\"pad\">\\n        <table class=\"kv\">\\n          <tr><td class=\"k\">PO Number</td><td class=\"c\">:</td><td>{{ doc.name }}</td></tr>\\n          <tr><td class=\"k\">Date</td><td class=\"c\">:</td><td>{{ frappe.utils.formatdate(doc.modified or doc.creation) }}</td></tr>\\n          <tr><td class=\"k\">Payables Status</td><td class=\"c\">:</td><td>{{ doc.payables_status or \"Draft\" }}</td></tr>\\n          <tr><td class=\"k\">Zoho Books Ref</td><td class=\"c\">:</td><td>{{ doc.zoho_books_reference or \"-\" }}</td></tr>\\n        </table>\\n      </td>\\n    </tr>\\n\\n    <tr>\\n      <td class=\"pad\">\\n        <b>Source References</b>\\n        <table class=\"kv\" style=\"margin-top: 4px;\">\\n          <tr><td class=\"k\">Transport Schedule</td><td class=\"c\">:</td><td>{{ doc.transport_schedule or \"-\" }}</td></tr>\\n          <tr><td class=\"k\">Job Order</td><td class=\"c\">:</td><td>{{ doc.job_order or \"-\" }}</td></tr>\\n          <tr><td class=\"k\">Shipping Booking</td><td class=\"c\">:</td><td>{{ doc.shipping_booking or \"-\" }}</td></tr>\\n        </table>\\n      </td>\\n      <td class=\"pad\">\\n        <b>Transport Details</b>\\n        <table class=\"kv\" style=\"margin-top: 4px;\">\\n          <tr><td class=\"k\">Transport Type</td><td class=\"c\">:</td><td>{{ doc.transport_type or \"-\" }}</td></tr>\\n          <tr><td class=\"k\">Outward Type</td><td class=\"c\">:</td><td>{{ doc.outward_type or \"-\" }}</td></tr>\\n          <tr><td class=\"k\">Transporter</td><td class=\"c\">:</td><td>{{ doc.transporter or \"-\" }}</td></tr>\\n          <tr><td class=\"k\">Vehicle</td><td class=\"c\">:</td><td>{{ doc.vehicle or \"-\" }}</td></tr>\\n          <tr><td class=\"k\">Driver</td><td class=\"c\">:</td><td>{{ doc.driver or \"-\" }}</td></tr>\\n        </table>\\n      </td>\\n    </tr>\\n\\n    <tr>\\n      <td class=\"pad\">\\n        <b>Schedule</b>\\n        <table class=\"kv\" style=\"margin-top: 4px;\">\\n          <tr><td class=\"k\">Scheduled Date</td><td class=\"c\">:</td><td>{{ frappe.utils.formatdate(doc.scheduled_date) if doc.scheduled_date else \"-\" }}</td></tr>\\n          <tr><td class=\"k\">Pickup Location</td><td class=\"c\">:</td><td>{{ doc.pickup_location or \"-\" }}</td></tr>\\n          <tr><td class=\"k\">Delivery Location</td><td class=\"c\">:</td><td>{{ doc.delivery_location or \"-\" }}</td></tr>\\n        </table>\\n      </td>\\n      <td class=\"pad\">\\n        <b>Commercials</b>\\n        <table class=\"kv\" style=\"margin-top: 4px;\">\\n          <tr><td class=\"k\">Currency</td><td class=\"c\">:</td><td>{{ doc.currency or \"-\" }}</td></tr>\\n          <tr><td class=\"k\">Transport Charges</td><td class=\"c\">:</td><td class=\"money\">{{ frappe.utils.fmt_money(doc.transport_charges or 0, currency=(doc.currency or \"AED\")) }}</td></tr>\\n        </table>\\n      </td>\\n    </tr>\\n\\n    <tr>\\n      <td colspan=\"2\" class=\"pad\">\\n        <b>Notes</b><br>\\n        {{ doc.notes or \"No notes.\" }}\\n      </td>\\n    </tr>\\n  </table>\\n\\n  <table class=\"signature-row\">\\n    <tr>\\n      <td><div class=\"sig-line\"></div>Prepared By</td>\\n      <td><div class=\"sig-line\"></div>Reviewed By</td>\\n      <td><div class=\"sig-line\"></div>Approved By</td>\\n    </tr>\\n  </table>\\n</div>\\n",
